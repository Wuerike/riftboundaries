    "trigger": "Timing or conditional hook that observes an event.",
    "cost": "Energy, rune, exhaust, sacrifice, discard, XP, or additional cost.",
    "resource": "Energy, rune, XP, card draw, or other generated resource.",
    "symbol": "Inline Riftbound symbol token such as :rb_energy_1:, :rb_rune_fury:, or :rb_exhaust:.",
