  "relation_roles": {
    "event_produced": "The unit can create an event or resource that may enable another card.",
    "trigger_observed": "The unit observes an event or timing window and can be enabled by something else.",
    "payoff_output": "The unit produces a payoff such as draw, damage, token, buff, resource, or score.",
    "cost_or_requirement": "The unit asks for a payment, additional cost, sacrifice, discard, timing, or state requirement.",
    "restriction_or_permission": "The unit permits, forbids, narrows, or broadens what can happen.",
    "state_or_modifier": "The unit changes state, stats, keywords, combat behavior, duration, or replacement behavior.",
    "targeting_or_scope": "The unit identifies affected objects, players, locations, or scopes.",
