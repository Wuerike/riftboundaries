    "target": "Targeting and ownership scope.",
    "location": "Zone or place: here, base, battlefield, hand, deck, trash, Champion Zone.",
    "stat": "Might, Power, Energy, score, point, or numeric stat change.",
    "keyword": "Bracketed keyword or granted/suppressed keyword.",
    "duration": "Duration window such as this turn, next time, while, until, or for as long as.",
